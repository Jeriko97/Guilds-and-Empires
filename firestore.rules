rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── PLAYER DATA ───────────────────────────────────────────────────────────
    // Lecture : propriétaire uniquement (request.auth.uid == uid).
    // Écriture client : INTERDITE. Toutes les mutations passent par Admin SDK (CF).
    match /players/{uid} {
      allow read:  if request.auth != null && request.auth.uid == uid;
      allow write: if false;

      match /buildings/{buildingId} {
        allow read:  if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
      match /contracts/{contractId} {
        allow read:  if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
      match /marketTrades/{tradeId} {
        allow read:  if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
      match /inventoryUpgrades/{upgradeId} {
        allow read:  if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
      match /guildPurchases/{purchaseId} {
        allow read:  if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }

    // ─── GLOBAL STATE ──────────────────────────────────────────────────────────
    // Lecture : tout utilisateur authentifié (ticker marché, events, contrats).
    // Écriture client : INTERDITE. Seules les Cloud Functions (Admin SDK) écrivent.
    match /marketState/{document} {
      allow read:  if request.auth != null;
      allow write: if false;
    }
    match /activeWorldEvents/{eventId} {
      allow read:  if request.auth != null;
      allow write: if false;
    }
    match /contractPool/{contractId} {
      allow read:  if request.auth != null;
      allow write: if false;
    }

    // ─── FALLBACK DENY-ALL ─────────────────────────────────────────────────────
    // Couvre les collections legacy (profiles, transactionLogs, rateLimits)
    // et toute collection non listée ci-dessus.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
