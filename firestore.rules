rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Profils joueurs ─────────────────────────────────────────────────────
    // Le client peut lire son propre profil (pour l'affichage en temps réel).
    //
    // create : autorisé uniquement depuis Unity après le signup Firebase Auth.
    //   - gold DOIT être 0 à la création (pas d'inflation client-side possible)
    //   - level DOIT être 1
    //   - schemaVersion DOIT être 1
    //
    // update / delete : INTERDITS au client.
    //   Toute mutation économique (gold, level) passe par la Cloud Function
    //   claimDailyBonus (Admin SDK, contourne ces règles).
    match /profiles/{uid} {
      allow read:   if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.gold == 0
                    && request.resource.data.level == 1
                    && request.resource.data.schemaVersion == 1;
      allow update: if false;
      allow delete: if false;
    }

    // ─── Logs d'idempotency ───────────────────────────────────────────────────
    // Enregistre chaque transaction traitée (nonce → résultat).
    // Le client peut lire ses propres logs (pour debug/UI), jamais écrire.
    match /transactionLogs/{nonce} {
      allow read:  if request.auth != null
                   && resource != null
                   && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // ─── Refus par défaut ─────────────────────────────────────────────────────
    // Toute collection non listée ci-dessus est bloquée au client.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
