<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <Style src="ProductionScreen.uss" />
    <ui:VisualElement name="production-screen" class="production-screen">
        <ui:Label name="title-label" text="Sawmill" class="title" />
        <ui:Label name="status-label" text="Chargement…" class="status status--loading" />
        <ui:Label name="economy-label" text="Or : —" class="economy" />
        <ui:ScrollView name="slots-container" class="slots-container" />
        <!-- Panneau de maintenance (19.4d, D-ETAPE19-010 Q5) : remplace la liste des slots ; textes posés par
             ProductionScreen depuis PlayerMessages. -->
        <ui:VisualElement name="maintenance-panel" class="maintenance-panel">
            <ui:Label name="maintenance-label" class="maintenance-text" />
            <ui:VisualElement name="maintenance-action-row" class="launch-row">
                <ui:Button name="retry-button" class="launch-action-btn launch-action-btn--primary" />
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- Panneau de lancement (19.4c-1) : textes posés par ProductionScreen depuis PlayerMessages. -->
        <ui:VisualElement name="launch-panel" class="launch-panel">
            <ui:VisualElement name="recipe-row" class="launch-row">
                <ui:Button name="recipe-logs-button" class="launch-choice-btn" />
                <ui:Button name="recipe-planks-button" class="launch-choice-btn" />
                <ui:Button name="recipe-kits-button" class="launch-choice-btn" />
            </ui:VisualElement>
            <ui:VisualElement name="cycles-row" class="launch-row">
                <ui:Button name="cycles-one-button" class="launch-choice-btn" />
                <ui:Button name="cycles-ten-button" class="launch-choice-btn" />
                <ui:Button name="cycles-max-button" class="launch-choice-btn" />
            </ui:VisualElement>
            <ui:Label name="preview-label" class="launch-preview" />
            <ui:Label name="saturation-label" class="launch-warning" />
            <ui:VisualElement name="action-row" class="launch-row">
                <ui:Button name="launch-button" class="launch-action-btn launch-action-btn--primary" />
                <ui:Button name="cancel-button" class="launch-action-btn" />
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- Confirmation d'arrêt (19.4c-2) : textes posés par ProductionScreen depuis PlayerMessages. -->
        <ui:VisualElement name="stop-confirm-panel" class="stop-confirm-panel">
            <ui:Label name="stop-confirm-label" class="stop-confirm-text" />
            <ui:VisualElement name="stop-action-row" class="launch-row">
                <ui:Button name="stop-confirm-button" class="launch-action-btn stop-confirm-btn" />
                <ui:Button name="stop-cancel-button" class="launch-action-btn" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Button name="collect-button" text="Collecter" class="collect-button" />
        <ui:Button name="market-button" text="Marché" class="market-button" />
    </ui:VisualElement>
</ui:UXML>
