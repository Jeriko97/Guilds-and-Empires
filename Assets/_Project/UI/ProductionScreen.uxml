<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <Style src="ProductionScreen.uss" />
    <ui:VisualElement name="production-screen" class="production-screen">
        <ui:Label name="title-label" text="Sawmill" class="title" />
        <ui:Label name="status-label" text="Chargement…" class="status status--loading" />
        <ui:Label name="economy-label" text="Or : —" class="economy" />
        <ui:ScrollView name="slots-container" class="slots-container" />
        <ui:Button name="collect-button" text="Collecter" class="collect-button" />
        <ui:Button name="market-button" text="Marché" class="market-button" />
    </ui:VisualElement>
</ui:UXML>
