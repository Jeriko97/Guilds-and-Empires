.market-screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(18, 18, 24);
    padding: 24px;
    flex-direction: column;
}

.title {
    font-size: 20px;
    color: rgb(220, 200, 140);
    margin-bottom: 12px;
    -unity-font-style: bold;
}

.status {
    font-size: 14px;
    color: rgb(180, 180, 180);
    margin-bottom: 20px;
}
