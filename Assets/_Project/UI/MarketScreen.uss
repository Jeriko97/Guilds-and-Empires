.market-screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(18, 18, 24);
    padding: 24px;
    flex-direction: column;
}

.title {
    font-size: 20px;
    color: rgb(220, 200, 140);
    margin-bottom: 12px;
    -unity-font-style: bold;
}

.status {
    font-size: 14px;
    color: rgb(180, 180, 180);
    margin-bottom: 20px;
}

.status--loading {
    color: rgb(160, 200, 255);
}

.status--error {
    color: rgb(255, 100, 100);
}

.status--success {
    color: rgb(100, 220, 100);
}

.gold {
    font-size: 16px;
    color: rgb(240, 210, 110);
    -unity-font-style: bold;
    margin-bottom: 12px;
}

/* ── Ressources ──────────────────────────────────────────────────────── */

.resources-container {
    flex-grow: 1;
    flex-shrink: 1;
    margin-bottom: 12px;
}

.back-button {
    flex-shrink: 0;
}

.resource-card {
    flex-shrink: 0;
    background-color: rgb(28, 28, 38);
    border-radius: 6px;
    padding: 14px;
    margin-bottom: 10px;
    flex-direction: column;
}

.resource-header {
    font-size: 13px;
    color: rgb(140, 160, 200);
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.resource-info {
    font-size: 13px;
    color: rgb(200, 200, 200);
    margin-bottom: 4px;
}

.resource-actions {
    flex-shrink: 0;
    flex-direction: row;
    margin-top: 6px;
}

.sell-btn {
    background-color: rgb(100, 80, 40);
    color: rgb(255, 235, 200);
    border-color: rgb(150, 120, 60);
    border-width: 1px;
    border-radius: 4px;
    padding: 6px 12px;
    margin-right: 8px;
    font-size: 13px;
    -unity-font-style: bold;
}

.sell-btn:hover {
    background-color: rgb(120, 96, 50);
}

.sell-btn:disabled {
    background-color: rgb(50, 44, 32);
    color: rgb(130, 120, 100);
    border-color: rgb(70, 60, 40);
}
