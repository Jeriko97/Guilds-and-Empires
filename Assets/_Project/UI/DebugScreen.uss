.debug-screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(18, 18, 24);
    padding: 24px;
    flex-direction: column;
}

.title {
    font-size: 20px;
    color: rgb(220, 200, 140);
    margin-bottom: 12px;
    -unity-font-style: bold;
}

.status {
    font-size: 14px;
    color: rgb(180, 180, 180);
    margin-bottom: 16px;
}

.status--loading {
    color: rgb(160, 200, 255);
}

.status--error {
    color: rgb(255, 100, 100);
}

.status--success {
    color: rgb(100, 220, 100);
}

.content-scroll {
    flex-grow: 1;
}

.content-container {
    flex-direction: column;
    padding: 8px;
}

.section-header {
    font-size: 13px;
    color: rgb(220, 200, 140);
    -unity-font-style: bold;
    margin-top: 12px;
    margin-bottom: 4px;
    padding-bottom: 2px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(60, 60, 80);
}

.field-row {
    flex-direction: row;
    margin-bottom: 3px;
}

.field-key {
    font-size: 12px;
    color: rgb(140, 160, 200);
    width: 200px;
    flex-shrink: 0;
}

.field-value {
    font-size: 12px;
    color: rgb(220, 220, 220);
    flex-grow: 1;
}

.field-value--highlight {
    color: rgb(255, 220, 80);
    -unity-font-style: bold;
}

.uid-label {
    font-size: 11px;
    color: rgb(100, 100, 120);
    margin-bottom: 8px;
    white-space: normal;
    overflow: visible;
}
